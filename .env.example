# Database
POSTGRES_DB=manutencao
POSTGRES_USER=manutencao_user
POSTGRES_PASSWORD=change_me_strong_password

# App
SECRET_KEY=change_me_very_long_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@suaempresa.com.br
EMAIL_FROM_NAME=Sistema de Manutenção

# Teams (optional — leave blank to disable)
TEAMS_WEBHOOK_URL=

# App settings
APP_NAME=Sistema de Manutenção Predial
BASE_URL=https://predial360.c-innovation.com.br

# Admin initial account (used only on first run)
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Administrador
